{
  "method": "mvsanywhere",
  "profile": "carla",
  "data": {
    "root": "/data/liuzonghao_data/dataset/MVS_Synth",
    "geometry_units": "scene_unit",
    "num_views": 4,
    "train_manifest": "prepared/manifests/train.jsonl",
    "val_manifest": "prepared/manifests/val.jsonl",
    "test_manifest": "prepared/manifests/test.jsonl",
    "split_protocol": "sequence",
    "supervision_depth_range": [
      2,
      80
    ]
  },
  "model": {
