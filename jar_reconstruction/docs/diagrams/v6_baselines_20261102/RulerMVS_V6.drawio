  <diagram id="flow-3" name="V6-4 候选交接与读出">
    <mxGraphModel page="1" pageWidth="621.0" pageHeight="1245.0" grid="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" parent="1" vertex="1" value="&lt;b style=&quot;font-size:25px&quot;&gt;V6 · 选哪一族，与族内在哪里，分别计算&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;粗层信息跨过细匹配保留下来；所有GT仅进入图底部训练支路。&lt;/span&gt;" style="html=1;fontFamily=Source Han Sans CN;fontColor=#223447;whiteSpace=wrap;spacing=6;text;strokeColor=none;fillColor=none;align=left;">
          <mxGeometry as="geometry" x="18" y="18" width="585.0" height="64" />
        </mxCell>
        <mxCell id="coarse" parent="1" vertex="1" value="96项粗概率 + 连续候选" style="html=1;fontFamily=Source Han Sans CN;fontColor=#223447;whiteSpace=wrap;spacing=6;shape=cube;size=5;direction=south;fontSize=19;fillColor=#F1EDFA;strokeColor=#8264AA;strokeWidth=1.5;">
          <mxGeometry as="geometry" x="79.5004" y="66.0" width="214.9992" height="36.0" />
        </mxCell>
        <mxCell id="transport" parent="1" vertex="1" value="同深度刻度概率传到细网格&lt;br&gt;选4峰，每峰布置3个局部点" style="html=1;fontFamily=Source Han Sans CN;fontColor=#223447;whiteSpace=wrap;spacing=6;rounded=1;arcSize=12;fontSize=19;fillColor=#DDF4EF;strokeColor=#07887E;strokeWidth=2.2;">
          <mxGeometry as="geometry" x="61.0" y="134.99992" width="252.0" height="56.00016" />
        </mxCell>
        <mxCell id="fine" parent="1" vertex="1" value="12个细候选重新取证&lt;br&gt;评分 s + 有界深度修正 z" style="html=1;fontFamily=Source Han Sans CN;fontColor=#223447;whiteSpace=wrap;spacing=6;rounded=1;arcSize=12;fontSize=19;fillColor=#F1EDFA;strokeColor=#8264AA;strokeWidth=1.5;">
          <mxGeometry as="geometry" x="246.5016" y="236.99992" width="220.9968" height="56.00016" />
        </mxCell>
        <mxCell id="parent" parent="1" vertex="1" value="所选父峰质量 p_c&lt;br&gt;归一化 / 停止梯度" style="html=1;fontFamily=Source Han Sans CN;fontColor=#223447;whiteSpace=wrap;spacing=6;shape=cube;size=5;direction=south;fontSize=19;fillColor=#DDF4EF;strokeColor=#07887E;strokeWidth=2.2;">
          <mxGeometry as="geometry" x="61.9988" y="338.99992" width="174.0024" height="56.00016" />
        </mxCell>
        <mxCell id="mass" parent="1" vertex="1" value="每族汇总3点得分&lt;br&gt;得到细层族质量 p_f" style="html=1;fontFamily=Source Han Sans CN;fontColor=#223447;whiteSpace=wrap;spacing=6;rounded=1;arcSize=12;fontSize=19;fillColor=#DDF4EF;strokeColor=#07887E;strokeWidth=2.2;">
          <mxGeometry as="geometry" x="262.5" y="338.99992" width="189.0" height="56.00016" />
        </mxCell>
        <mxCell id="local" parent="1" vertex="1" value="每族内部softmax&lt;br&gt;3个连续深度加权 → μ" style="html=1;fontFamily=Source Han Sans CN;fontColor=#223447;whiteSpace=wrap;spacing=6;rounded=1;arcSize=12;fontSize=19;fillColor=#F1EDFA;strokeColor=#8264AA;strokeWidth=1.5;">
          <mxGeometry as="geometry" x="389.0004" y="410.99992" width="205.9992" height="56.00016" />
        </mxCell>
        <mxCell id="quality" parent="1" vertex="1" value="父/细熵、分歧、null等6个量&lt;br&gt;6→16→1 → sigmoid" style="html=1;fontFamily=Source Han Sans CN;fontColor=#223447;whiteSpace=wrap;spacing=6;rounded=1;arcSize=12;fontSize=19;fillColor=#DDF4EF;strokeColor=#07887E;strokeWidth=2.2;">
          <mxGeometry as="geometry" x="54.4992" y="482.99992" width="263.0016" height="56.00016" />
        </mxCell>
        <mxCell id="mix" parent="1" vertex="1" value="粗细族质量融合&lt;br&gt;q ∝ p_f^(1−α) · p_c^α" style="html=1;fontFamily=Source Han Sans CN;fontColor=#223447;whiteSpace=wrap;spacing=6;rounded=1;arcSize=12;fontSize=19;fillColor=#DDF4EF;strokeColor=#07887E;strokeWidth=2.2;">
