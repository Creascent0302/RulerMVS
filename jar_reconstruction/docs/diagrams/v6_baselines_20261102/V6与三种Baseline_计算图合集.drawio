                <mxCell id="select" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#C48836;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="选择4个粗峰&lt;br&gt;继承粗特征与父质量p_c&lt;br&gt;步长=max(半格宽, 0.5/‖g‖)&lt;br&gt;限幅后每峰取−步长/0/+步长" vertex="1">
                    <mxGeometry height="170" width="440" x="590" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="fine" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="12个细候选重新取证&lt;br&gt;精确投影 + 共享匹配/上下文&lt;br&gt;加入继承粗特征 → LN&lt;br&gt;score s_gk + 连续深度 z_gk" vertex="1">
                    <mxGeometry height="170" width="440" x="1130" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="reshape" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3F0;strokeColor=#087E83;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="按父峰组织4族×3点&lt;br&gt;族内：r_gk = softmax_k(s_gk)&lt;br&gt;族间：p_f ∝ Σ_k exp(s_gk)&lt;br&gt;每族深度 μ_g = Σ_k r_gk z_gk" vertex="1">
                    <mxGeometry height="170" width="440" x="1670" y="200" as="geometry"/>
                </mxCell>
                <mxCell id="parent" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3F0;strokeColor=#087E83;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="父质量归一化&lt;br&gt;保留4个所选粗峰质量&lt;br&gt;有效族内归一；停止梯度&lt;br&gt;没有父质量时回退p_f" vertex="1">
                    <mxGeometry height="170" width="440" x="590" y="490" as="geometry"/>
                </mxCell>
                <mxCell id="quality" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3F0;strokeColor=#087E83;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="6个质量统计（停止梯度）&lt;br&gt;父/细熵、内积、JS分歧&lt;br&gt;null质量、有效源比例&lt;br&gt;每像素6维" vertex="1">
                    <mxGeometry height="170" width="440" x="1130" y="490" as="geometry"/>
                </mxCell>
                <mxCell id="gate" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3F0;strokeColor=#087E83;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="QualityGate：129参数&lt;br&gt;1×1 Conv 6→16 → GELU&lt;br&gt;1×1 Conv 16→1 → Sigmoid&lt;br&gt;一个像素共享一个门α" vertex="1">
                    <mxGeometry height="170" width="440" x="1670" y="490" as="geometry"/>
