                </mxCell>
                <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=19;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="蓝：图像特征    橙：标定与采样    紫：候选推理    青：V6重点机制    绿：输出    灰虚线：训练或可选路径" vertex="1">
                    <mxGeometry height="45" width="2080" x="40" y="1392" as="geometry"/>
                </mxCell>
                <mxCell id="coarse" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="粗分布 + 连续候选&lt;br&gt;96个共同深度刻度&lt;br&gt;四粗邻居同刻度概率传递&lt;br&gt;目标网格64×112" vertex="1">
                    <mxGeometry height="170" width="440" x="50" y="200" as="geometry"/>
