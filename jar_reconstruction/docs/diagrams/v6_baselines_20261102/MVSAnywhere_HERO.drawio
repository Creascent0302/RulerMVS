  <diagram id="flow-1" name="MVSA-2 匹配到深度">
    <mxGraphModel page="1" pageWidth="901.0" pageHeight="1255.1" grid="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" parent="1" vertex="1" value="&lt;b style=&quot;font-size:25px&quot;&gt;MVSAnywhere · 匹配体如何变成深度&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;所有维度以256×448共同输入说明；metadata MLP主模型，不是dot消融。&lt;/span&gt;" style="html=1;fontFamily=Source Han Sans CN;fontColor=#223447;whiteSpace=wrap;spacing=6;text;strokeColor=none;fillColor=none;align=left;">
