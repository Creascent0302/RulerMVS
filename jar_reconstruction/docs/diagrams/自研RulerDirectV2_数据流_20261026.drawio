  <diagram id="ruler-v2-1" name="02 两条编码支路与每层尺寸">
    <mxGraphModel page="1" pageWidth="2000" pageHeight="1730" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=35;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="编码阶段：纹理支路与上下文支路">
          <mxGeometry as="geometry" x="35" y="15" width="1930" height="65" />
        </mxCell>
        <mxCell id="subtitle" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="结构来自当前 encoders.py｜下列形状按 B=1、N=4 展示；每台相机使用同一套权重">
          <mxGeometry as="geometry" x="35" y="80" width="1930" height="55" />
        </mxCell>
        <mxCell id="match_input" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="匹配图：合并B和N&lt;br&gt;[4,3,512,896]&lt;br&gt;掩码置零 → ImageNet归一化">
          <mxGeometry as="geometry" x="40" y="170" width="470" height="140" />
        </mxCell>
        <mxCell id="stem" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="ResNet-18 stem&lt;br&gt;Conv7×7，stride2，3→64 → BN → ReLU&lt;br&gt;MaxPool3×3，stride2&lt;br&gt;[4,64,128,224]">
          <mxGeometry as="geometry" x="40" y="380" width="470" height="175" />
        </mxCell>
        <mxCell id="c2" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="layer1：2个BasicBlock&lt;br&gt;通道64，首块stride1&lt;br&gt;[4,64,128,224]">
          <mxGeometry as="geometry" x="40" y="625" width="470" height="145" />
        </mxCell>
        <mxCell id="c3" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="layer2：2个BasicBlock&lt;br&gt;64→128，首块stride2&lt;br&gt;[4,128,64,112]">
          <mxGeometry as="geometry" x="40" y="840" width="470" height="145" />
        </mxCell>
        <mxCell id="c4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="layer3：2个BasicBlock&lt;br&gt;128→256，首块stride2&lt;br&gt;[4,256,32,56]">
          <mxGeometry as="geometry" x="40" y="1055" width="470" height="145" />
        </mxCell>
        <mxCell id="c5" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="layer4：2个BasicBlock&lt;br&gt;256→512，首块stride2&lt;br&gt;[4,512,16,28]">
          <mxGeometry as="geometry" x="40" y="1270" width="470" height="145" />
        </mxCell>
        <mxCell id="f4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=20;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="F4：侧投影64→64 + 对齐的上层结果&lt;br&gt;DW Conv3×3 → PW Conv1×1 → GN8 → GELU&lt;br&gt;输出 [B,N,64,128,224]，匹配图stride4">
          <mxGeometry as="geometry" x="620" y="625" width="610" height="145" />
        </mxCell>
        <mxCell id="f8" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=20;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="F8：侧投影128→64 + 对齐的上层结果&lt;br&gt;DW Conv3×3 → PW Conv1×1 → GN8 → GELU&lt;br&gt;输出 [B,N,64,64,112]，匹配图stride8">
          <mxGeometry as="geometry" x="620" y="840" width="610" height="145" />
        </mxCell>
        <mxCell id="f16" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=20;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="F16：侧投影256→64 + 对齐的上层结果&lt;br&gt;DW Conv3×3 → PW Conv1×1 → GN8 → GELU&lt;br&gt;输出 [B,N,64,32,56]，匹配图stride16">
          <mxGeometry as="geometry" x="620" y="1055" width="610" height="145" />
        </mxCell>
        <mxCell id="f32" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=20;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="最深侧投影：Conv1×1，512→64&lt;br&gt;[4,64,16,28]，匹配图stride32&lt;br&gt;参与自顶向下融合，不作为第4张输出图">
          <mxGeometry as="geometry" x="620" y="1270" width="610" height="145" />
        </mxCell>
        <mxCell id="cnn_note" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#8D96A3;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="BasicBlock：Conv3×3 → BN → ReLU → Conv3×3 → BN → 加捷径 → ReLU&lt;br&gt;通道/步长变化时捷径用1×1卷积；BN运行统计冻结，仿射参数可训练&lt;br&gt;FPN向上传递的是平滑前特征；DW为逐通道卷积，PW为1×1通道混合&lt;br&gt;匹配格点中心按标准ResNet推导，不套用旧Hero匹配支路的中心偏移">
          <mxGeometry as="geometry" x="40" y="1500" width="1190" height="175" />
        </mxCell>
        <mxCell id="ref_input" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="参考主图 [B,3,256,448]&lt;br&gt;掩码置零 → ImageNet归一化&lt;br&gt;按14/16缩放为 [B,3,224,392]">
          <mxGeometry as="geometry" x="1320" y="170" width="640" height="140" />
        </mxCell>
        <mxCell id="patch" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="ViT-B patch嵌入&lt;br&gt;Conv14×14，stride14，3→768&lt;br&gt;16×28＝448个patch + 1个CLS&lt;br&gt;加位置编码 → [B,449,768]">
          <mxGeometry as="geometry" x="1320" y="380" width="640" height="175" />
        </mxCell>
        <mxCell id="vit_blocks" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="12个Transformer Block，通道768&lt;br&gt;每块：LayerNorm → 12头自注意力&lt;br&gt;LayerScale → 加残差&lt;br&gt;LayerNorm → Linear768→3072 → GELU&lt;br&gt;Linear3072→768 → LayerScale → 加残差&lt;br&gt;在第3、6、9、12块读取特征">
          <mxGeometry as="geometry" x="1320" y="625" width="640" height="245" />
        </mxCell>
        <mxCell id="four_raw" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="共享末端LayerNorm → 丢弃CLS&lt;br&gt;四份 [B,768,16,28]&lt;br&gt;它们的空间尺寸相同，语义深度不同&lt;br&gt;不是四张不同分辨率的图">
          <mxGeometry as="geometry" x="1320" y="950" width="640" height="175" />
        </mxCell>
        <mxCell id="adapters" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="四个独立raw_adapters&lt;br&gt;各Conv1×1：768→128&lt;br&gt;四份 [B,128,16,28]&lt;br&gt;粗/细阶段按主图patch中心7.5+16j对齐">
          <mxGeometry as="geometry" x="1320" y="1210" width="640" height="175" />
        </mxCell>
        <mxCell id="vit_note" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#8D96A3;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="权重起点：原始Depth Anything V2 Base&lt;br&gt;阶段1：冻结ViT；阶段2：末4块及末端LN可训&lt;br&gt;阶段3/4：全ViT可训&lt;br&gt;本支路没有执行DA-V2的DPT深度头&lt;br&gt;可训练块启用激活重计算，只影响训练内存">
          <mxGeometry as="geometry" x="1320" y="1470" width="640" height="205" />
        </mxCell>
