  <diagram id="ruler-v2-2" name="03 标尺匹配与两种注意力">
    <mxGraphModel page="1" pageWidth="2200" pageHeight="2050" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=35;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="匹配与融合：标尺管取证，图像管证据">
          <mxGeometry as="geometry" x="35" y="15" width="2130" height="65" />
        </mxCell>
        <mxCell id="subtitle" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="本页的模块在粗层与细层各调用一次并共享参数；粗D=96、32×56，细D=12、64×112">
          <mxGeometry as="geometry" x="35" y="80" width="2130" height="55" />
        </mxCell>
        <mxCell id="start" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#C48836;fontSize=23;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="输入：候选深度Z、参考像素网格、K/T、视图/像素掩码、匹配FPN与四层ViT上下文&lt;br&gt;所有候选均为待判断假设；投影在图内不等于无遮挡，也不等于存在真实表面">
          <mxGeometry as="geometry" x="40" y="155" width="2120" height="110" />
        </mxCell>
        <mxCell id="unproject" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#C48836;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="① unproject：反投影&lt;br&gt;参考像素 + 候选Z → 阵列点X&lt;br&gt;同时得到射线方向 dX/dZ&lt;br&gt;候选区间半宽为 ΔZ&lt;br&gt;Z是光轴深度，不是射线距离">
          <mxGeometry as="geometry" x="40" y="355" width="470" height="205" />
        </mxCell>
        <mxCell id="project" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#C48836;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="② project：精确重投影&lt;br&gt;X → 每台源相机的像素u、v&lt;br&gt;计算投影导数J&lt;br&gt;g = J·dX/dZ&lt;br&gt;屏蔽图外、负深度、缺图与退化源">
          <mxGeometry as="geometry" x="590" y="355" width="470" height="205" />
        </mxCell>
        <mxCell id="route" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#C48836;fontSize=20;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="③ 标尺尺度路由&lt;br&gt;计算横向/纵向/深度跨度的投影&lt;br&gt;最大跨度p决定F4/F8/F16权重&lt;br&gt;目标约4个特征像素&lt;br&gt;实现采样三层，相邻最多两层权重非零">
          <mxGeometry as="geometry" x="1140" y="355" width="470" height="205" />
        </mxCell>
        <mxCell id="samples" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="④ grid_sample + L2归一化&lt;br&gt;参考描述子固定读取F4&lt;br&gt;源描述子按路由权重混合&lt;br&gt;四目只算3个源，每源64通道&lt;br&gt;源 [B,3,64,D,H,W]">
          <mxGeometry as="geometry" x="1690" y="355" width="470" height="205" />
        </mxCell>
        <mxCell id="reference" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑤a 参考query与拒绝分支&lt;br&gt;f_ref：64维&lt;br&gt;Linear64→64：Q，拆成4头×16维&lt;br&gt;Linear64→4：每头的null分数&lt;br&gt;Q不随候选深度改变">
          <mxGeometry as="geometry" x="40" y="720" width="470" height="210" />
        </mxCell>
        <mxCell id="keys" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑤b 源key&lt;br&gt;在当前候选投影处取f_src：64维&lt;br&gt;Linear64→64：K，拆成4头×16维&lt;br&gt;候选改变 → 取样位置与源key改变&lt;br&gt;分数的外观部分：Q·K / 4">
          <mxGeometry as="geometry" x="590" y="720" width="470" height="210" />
        </mxCell>
        <mxCell id="pair" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑤c 成对描述：拼成139维&lt;br&gt;逐通道乘积：64&lt;br&gt;逐通道绝对差：64&lt;br&gt;8组乘积求和：8&lt;br&gt;标尺方向2 + log(1+|g|ΔZ)：1">
          <mxGeometry as="geometry" x="1140" y="720" width="470" height="210" />
        </mxCell>
        <mxCell id="mlp" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑤d pair + reliability&lt;br&gt;MLP：139→64 → GELU →64&lt;br&gt;输出64维value&lt;br&gt;Linear64→4：可靠性分数&lt;br&gt;它与Q·K共同决定各头源权重">
          <mxGeometry as="geometry" x="1690" y="720" width="470" height="210" />
        </mxCell>
        <mxCell id="weights" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=20;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑥ 在源视图维做masked softmax&lt;br&gt;每头：3个源分数 + 1个null分数&lt;br&gt;无效源的权重为0，null始终可选&lt;br&gt;不把拒绝的概率重新分给剩余源&lt;br&gt;权重用于value聚合和证据质量统计">
          <mxGeometry as="geometry" x="590" y="1050" width="470" height="215" />
        </mxCell>
        <mxCell id="pooled" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑦ 聚合得到三个量&lt;br&gt;pooled：4头value加权合并，64维&lt;br&gt;null_mass：4头无匹配权重均值，1维&lt;br&gt;information：按源权重加权的 |g|²，取log1p后为1维&lt;br&gt;合计66维；information是几何敏感度，不是纹理置信度">
          <mxGeometry as="geometry" x="1140" y="1050" width="1020" height="215" />
        </mxCell>
        <mxCell id="position" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#C48836;fontSize=20;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑧b 深度位置编码&lt;br&gt;将 log Z 在 near/far 之间归一化为p&lt;br&gt;p、sin(πp)、cos(πp)共3维&lt;br&gt;Linear3→64 → GELU → Linear64→64">
          <mxGeometry as="geometry" x="590" y="1350" width="470" height="170" />
        </mxCell>
        <mxCell id="evidence" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑧a evidence：Conv3D1×1×1 66→64 → GELU → Conv3D1×1×1 64→64&lt;br&gt;加上⑧b深度位置编码，形成候选token [B,64,D,H,W]">
          <mxGeometry as="geometry" x="1140" y="1350" width="1020" height="170" />
        </mxCell>
        <mxCell id="bank" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑨ 四层参考图上下文 bank&lt;br&gt;每层128维，按当前网格精确对齐&lt;br&gt;[B,128,4,H,W]&lt;br&gt;同一像素的四个层级作为key/value&lt;br&gt;这一步是选编码层，不是选相机">
          <mxGeometry as="geometry" x="40" y="1650" width="600" height="245" />
        </mxCell>
        <mxCell id="query" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑩ 候选query读取上下文&lt;br&gt;raw_query：Conv3D1×1×1 64→128&lt;br&gt;query与四层bank点积 / √128&lt;br&gt;softmax沿4个编码层归一化&lt;br&gt;不同候选可以选择不同层级">
          <mxGeometry as="geometry" x="760" y="1650" width="550" height="245" />
        </mxCell>
        <mxCell id="fused" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑪ 四层加权求和 → 128维&lt;br&gt;raw_output：Conv3D1×1×1 128→64&lt;br&gt;与原候选token相加 → 通道LayerNorm → 掩码&lt;br&gt;粗输出 [B,64,96,32,56]&lt;br&gt;细输出 [B,64,12,64,112]">
          <mxGeometry as="geometry" x="1430" y="1650" width="730" height="245" />
        </mxCell>
        <mxCell id="note" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="所有候选中心精确重投影；J仅用于尺度、注意力几何条件和后续步长。无匹配槽位由最终任务间接学习，当前没有独立null监督头。">
