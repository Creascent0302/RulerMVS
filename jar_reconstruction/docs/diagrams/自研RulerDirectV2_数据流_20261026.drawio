<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" pages="4">
  <diagram id="ruler-v2-0" name="01 按数据流阅读总图">
    <mxGraphModel page="1" pageWidth="1800" pageHeight="2310" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=35;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="当前自研架构：RulerDirect-V2">
          <mxGeometry as="geometry" x="35" y="15" width="1730" height="65" />
        </mxCell>
        <mxCell id="subtitle" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="PretrainingModel → CalibratedDecoder｜实线：推理数据流｜蓝：图像｜橙：标定｜紫：候选解码">
          <mxGeometry as="geometry" x="35" y="80" width="1730" height="55" />
        </mxCell>
        <mxCell id="input" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="① RGB与有效掩码：示例 B=1，N=4&lt;br&gt;主图 [B,N,3,256,448]；匹配图 [B,N,3,512,896]&lt;br&gt;两种尺寸分别从原始RGB缩放；targets不进入模型">
          <mxGeometry as="geometry" x="500" y="155" width="800" height="135" />
        </mxCell>
        <mxCell id="cnn" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="②a MatchingPyramid：全部有效视图共享&lt;br&gt;ImageNet ResNet-18 → 四级侧投影 → 对齐FPN&lt;br&gt;输出F4/F8/F16，各64维；负责纹理与定位&lt;br&gt;编码器参与训练，非冻结Hero特征">
          <mxGeometry as="geometry" x="50" y="365" width="740" height="180" />
        </mxCell>
        <mxCell id="vit" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="②b TrainableFoundation：本次参考图&lt;br&gt;原始DA-V2 ViT-B／12块，取第3/6/9/12块&lt;br&gt;四张 [B,768,16,28] 上下文图&lt;br&gt;负责结构与场景理解；分阶段解冻">
          <mxGeometry as="geometry" x="1010" y="365" width="740" height="180" />
        </mxCell>
        <mxCell id="geometry" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DF;strokeColor=#C48836;fontSize=20;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="独立几何输入&lt;br&gt;K：主图内参&lt;br&gt;T_cam_from_rig：阵列→相机&lt;br&gt;每域固定 near / far / s&lt;br&gt;平移与候选除以 s&lt;br&gt;范围来自TRAIN配置，非本帧GT">
          <mxGeometry as="geometry" x="40" y="620" width="380" height="240" />
        </mxCell>
        <mxCell id="context" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF2FF;strokeColor=#477BC2;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="上下文准备／重复使用&lt;br&gt;四个独立1×1卷积&lt;br&gt;768 → 128 维&lt;br&gt;按真实patch中心对齐&lt;br&gt;粗层：32×56&lt;br&gt;细层：64×112">
          <mxGeometry as="geometry" x="1380" y="620" width="380" height="240" />
        </mxCell>
        <mxCell id="candidates" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="③ 全范围粗候选：set_range + depth_lattice&lt;br&gt;每个stride-8像素沿射线布置96个对数深度候选&lt;br&gt;候选位置 [B,96,32,56]，采用工作单位">
          <mxGeometry as="geometry" x="500" y="610" width="800" height="140" />
        </mxCell>
        <mxCell id="observe" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="④ _observe + CandidateViewAttention&lt;br&gt;候选精确投影 → 标尺选择特征尺度 → 采样源特征&lt;br&gt;成对特征MLP + 4头源视图注意力 + 无匹配槽位&lt;br&gt;四目时只计算3个源；几何无效源被屏蔽">
          <mxGeometry as="geometry" x="500" y="825" width="800" height="180" />
        </mxCell>
        <mxCell id="fusion" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑤ 候选解释：_tokens_from_source + CandidateScaleSpace&lt;br&gt;66→64证据编码 + 深度位置编码 + 四层上下文读取&lt;br&gt;在32×56／16×28／8×14三个空间尺度交换候选信息&lt;br&gt;保留全部96个深度格；得到 [B,64,96,32,56]">
          <mxGeometry as="geometry" x="500" y="1080" width="800" height="180" />
        </mxCell>
        <mxCell id="transport" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=22;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑥ 粗预测 + SubrayTransport&lt;br&gt;分数头与有界连续偏移 → 96项候选概率&lt;br&gt;先传递全部概率到64×112细网格，再选4个峰&lt;br&gt;每峰按标尺步长取3点；共12个候选，并继承粗特征">
          <mxGeometry as="geometry" x="500" y="1335" width="800" height="185" />
        </mxCell>
        <mxCell id="fine" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑦ 细层重新取证与选面：_observe → _tokens → _prediction&lt;br&gt;12个候选重新精确投影，复用④的注意力与⑤的上下文读取&lt;br&gt;加上1×1×1投影后的继承特征，再做通道LayerNorm&lt;br&gt;共享粗层分数/偏移头；取最高分候选，输出连续深度&lt;br&gt;细层不再执行CandidateScaleSpace">
          <mxGeometry as="geometry" x="500" y="1595" width="800" height="205" />
        </mxCell>
        <mxCell id="upsample" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1ECFF;strokeColor=#8665BC;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑧ _upsample：学习式4倍凸组合上采样&lt;br&gt;选中候选特征 → Conv3×3 → GELU → Conv1×1&lt;br&gt;预测9邻域×16子像素权重，将64×112恢复至256×448">
          <mxGeometry as="geometry" x="500" y="1875" width="800" height="145" />
        </mxCell>
        <mxCell id="output" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5EE;strokeColor=#408766;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="⑨ 单参考深度输出 [B,1,256,448]&lt;br&gt;导出时 depth × s，恢复该数据域的原始长度单位&lt;br&gt;同时给出 confidence / valid / support&lt;br&gt;当前 unknown=true，observed=false，state=2&lt;br&gt;表示深度假设；尚未认证为已观测表面">
          <mxGeometry as="geometry" x="500" y="2090" width="800" height="185" />
        </mxCell>
        <mxCell id="roles" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#8D96A3;fontSize=20;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="当前相机角色&lt;br&gt;所有相机共用CNN参数&lt;br&gt;一次forward指定一个参考相机&lt;br&gt;ViT只处理该参考图&lt;br&gt;请求其他参考要另做前向&lt;br&gt;当前入口未自动共享多参考编码">
          <mxGeometry as="geometry" x="40" y="1080" width="380" height="245" />
        </mxCell>
        <mxCell id="training" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#8D96A3;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="训练标签另走监督支路&lt;br&gt;GT深度与可见对应&lt;br&gt;只进入损失函数&lt;br&gt;不会成为推理输入&lt;br&gt;完整训练流程见第4页">
          <mxGeometry as="geometry" x="40" y="1600" width="380" height="220" />
        </mxCell>
        <mxCell id="shape" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#8D96A3;fontSize=21;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="尺寸读法&lt;br&gt;B：一批图组数量&lt;br&gt;N：输入相机数量&lt;br&gt;C：特征通道数&lt;br&gt;D：候选深度数量&lt;br&gt;H×W：当前空间网格">
          <mxGeometry as="geometry" x="1380" y="1080" width="380" height="245" />
        </mxCell>
        <mxCell id="disabled" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F5;strokeColor=#8D96A3;fontSize=20;fontFamily=Microsoft YaHei;spacing=8;strokeWidth=2;" value="本图不含的历史模块&lt;br&gt;无完整Hero融合ViT／DPT&lt;br&gt;无旧树头、GN后端或tele输入&lt;br&gt;场景token分支关闭&lt;br&gt;独立细头与峰内平均关闭&lt;br&gt;可选浮点重排加速关闭">
          <mxGeometry as="geometry" x="1380" y="1600" width="380" height="245" />
        </mxCell>
