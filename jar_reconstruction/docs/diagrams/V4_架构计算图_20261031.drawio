  <diagram id="v4-2" name="03 Flow与训练展开">
    <mxGraphModel page="1" pageWidth="1800" pageHeight="2080" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="V4 新增模块：保持选面，修正每个候选区间内的位置" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7A8796;fontColor=#182535;fontSize=30;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;fillColor=none;strokeColor=none;">
          <mxGeometry x="35" y="15" width="1730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="绿：实际推理路径｜紫色虚线：仅训练的监督分支｜默认 inference_steps=1，noise_sigma=0。" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7A8796;fontColor=#182535;fontSize=20;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;fillColor=none;strokeColor=none;">
          <mxGeometry x="35" y="78" width="1730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="features" value="细层候选特征 [B,64,12,64,112]&lt;br&gt;按 4 组、每组三点整理&lt;br&gt;每组 3×64 = 192 通道&lt;br&gt;[4B,192,64,112]" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="45" y="165" width="520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="stats" value="原 score / 相似度 / 支持比例 / null&lt;br&gt;相对深度 / 区间宽度 / 标尺足迹 / 有效性&lt;br&gt;以上各3维 + 组深度位置1 + 组跨度1&lt;br&gt;合计 26 通道；仅描述原取证位置&lt;br&gt;与192维特征拼接 → 218通道" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#B97A18;fontColor=#182535;fontSize=20;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="625" y="165" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="old" value="原偏移头输出 Z_old 与 cell [L,U]&lt;br&gt;width = U−L；有效宽度掩码&lt;br&gt;anchor = 2×(Z_old−L)/width − 1&lt;br&gt;12 个候选各有自己的局部坐标" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=20;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="1260" y="165" width="490" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ctx" value="一次构造证据上下文：[4B,218,64,112]&lt;br&gt;Conv1×1 218→48 → GroupNorm(8) → SiLU&lt;br&gt;输出 [4B,48,64,112]，供速度头复用" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F5E9;strokeColor=#29804B;fontColor=#182535;fontSize=22;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="290" y="445" width="680" height="125" as="geometry" />
        </mxCell>
        <mxCell id="neighbors" value="区间门控四邻域消息（上 / 下 / 左 / 右）&lt;br&gt;只连接邻像素的同序号组，屏蔽环绕边界&lt;br&gt;交叠长度 / 两组最大宽度 → 门控差分&lt;br&gt;Conv1×1 48→48 + 残差 → GroupNorm → SiLU" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F5E9;strokeColor=#29804B;fontColor=#182535;fontSize=22;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="290" y="645" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="state" value="推理状态从 anchor 开始&lt;br&gt;三点当前状态 3维 + 原anchor 3维&lt;br&gt;时间条件 (r,t,t−r,sin πt) 共4维&lt;br&gt;一步推理取 r=0，t=1" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F5E9;strokeColor=#29804B;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="1250" y="555" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="velocity" value="平均速度头：[48+3+3+4]=58 通道&lt;br&gt;Conv1×1 58→48 → SiLU&lt;br&gt;Conv1×1 48→48 → SiLU → Conv1×1 48→3&lt;br&gt;2×tanh，输出每组三个有界速度" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F5E9;strokeColor=#29804B;fontColor=#182535;fontSize=22;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="290" y="915" width="680" height="165" as="geometry" />
        </mxCell>
        <mxCell id="update" value="局部更新 q_new = clamp(anchor−u, −1,1)&lt;br&gt;Z_new = Z_old + 0.5×width×(q_new−anchor)&lt;br&gt;无效或退化区间不加修正&lt;br&gt;不重新采样图像，不改变 score / winner" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F5E9;strokeColor=#29804B;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="290" y="1160" width="680" height="150" as="geometry" />
        </mxCell>
        <mxCell id="selected" value="原 argmax 赢家选取 Z_new&lt;br&gt;[B,1,64,112] → 原凸上采样 ×4&lt;br&gt;[B,1,256,448] 深度输出" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=22;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="290" y="1385" width="680" height="115" as="geometry" />
        </mxCell>
        <mxCell id="gt" value="仅训练：GT深度和有效标签&lt;br&gt;只给 GT 落入真实 cell 的候选定位责任&lt;br&gt;GT不进入推理输入或窗口生成" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFB;strokeColor=#8754A5;fontColor=#182535;fontSize=20;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="1250" y="835" width="500" height="125" as="geometry" />
        </mxCell>
        <mxCell id="startloss" value="真实起点端点监督，权重1.0&lt;br&gt;u(anchor,0,1) 对齐 anchor−GT局部坐标&lt;br&gt;不能靠接近GT的训练状态掩盖起点错误" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFB;strokeColor=#8754A5;fontColor=#182535;fontSize=19;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="1250" y="1050" width="500" height="115" as="geometry" />
        </mxCell>
        <mxCell id="bridge" value="MeanFlow 辅助监督，权重0.25&lt;br&gt;构造 GT→anchor 的中间状态与两时刻&lt;br&gt;同一速度头 + JVP 构造平均速度目标&lt;br&gt;JVP不重算图像投影；目标停止梯度&lt;br&gt;默认不加高斯噪声" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFB;strokeColor=#8754A5;fontColor=#182535;fontSize=19;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="1250" y="1250" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="native" value="同时保留原训练监督&lt;br&gt;全图 / 粗细深度、候选分类与风险等&lt;br&gt;共同训练可更新原表示与评分头&lt;br&gt;不是只训练新增18,339参数" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EAFB;strokeColor=#8754A5;fontColor=#182535;fontSize=20;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="1250" y="1530" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="推理时：上下文一次，速度头一次；训练时：额外调用同一小头构造 MeanFlow 监督。&lt;br&gt;Flow 的直接作用是区间内连续定位，不能直接恢复区间外表面、重新选峰或认证遮挡。&lt;br&gt;保留模块结构 ≠ 冻结其参数：联合训练仍可能改变原粗候选、评分和编码表示。" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7A8796;fontColor=#182535;fontSize=22;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="60" y="1750" width="1680" height="125" as="geometry" />
        </mxCell>
        <mxCell id="files" value="代码：research/ruler_flow_v2_20261031/{model.py,field.py,losses.py}&lt;br&gt;继承：jar/pretraining/{encoders.py,model.py}；jar/models/{ruler_direct.py,ruler_proposals.py,ruler_spatial.py}&lt;br&gt;依据：本轮 public/config.json；维度为原生 256×448 主图、512×896 匹配图。" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7A8796;fontColor=#182535;fontSize=20;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
