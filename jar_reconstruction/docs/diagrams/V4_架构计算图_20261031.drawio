<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" pages="3">
  <diagram id="v4-0" name="01 总计算图">
    <mxGraphModel page="1" pageWidth="1740" pageHeight="2050" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="V4：标定候选匹配 + 缓存证据上的一步局部 Flow" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7A8796;fontColor=#182535;fontSize=30;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;fillColor=none;strokeColor=none;">
          <mxGeometry x="35" y="15" width="1670" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="蓝：继承 V2 的模块结构（参数可续训）｜橙：标定计算｜绿：V4 新增｜单参考输出路径" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7A8796;fontColor=#182535;fontSize=20;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;fillColor=none;strokeColor=none;">
          <mxGeometry x="35" y="78" width="1670" height="55" as="geometry" />
        </mxCell>
        <mxCell id="input" value="同步 RGB + K + T_cam_from_rig&lt;br&gt;有效相机 / 像素掩码；不输入 GT&lt;br&gt;示例 B 批次，N=4，参考为上相机" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=22;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="560" y="150" width="510" height="120" as="geometry" />
        </mxCell>
        <mxCell id="match" value="四目共享匹配编码器&lt;br&gt;512×896 → ResNet-18 → 对齐 FPN&lt;br&gt;F4: [B,N,64,128,224]&lt;br&gt;F8: [B,N,64,64,112]&lt;br&gt;F16: [B,N,64,32,56]" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="40" y="330" width="460" height="180" as="geometry" />
        </mxCell>
        <mxCell id="vit" value="参考图语义编码器&lt;br&gt;DA-V2初始化的 DINOv2 ViT-B/14&lt;br&gt;256×448→224×392；取3/6/9/12层&lt;br&gt;4 张 [B,768,16,28]&lt;br&gt;各自 1×1 投影：768 → 128" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="570" y="330" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="geo" value="标定 → 精确投影与空间标尺&lt;br&gt;候选 Z → 三维点 → 各源图像坐标&lt;br&gt;J 与沿参考射线的投影导数 g&lt;br&gt;几何有效性 / 投影尺度 / 搜索步长&lt;br&gt;由标定计算，不新增传感器信息" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#B97A18;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="1160" y="330" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="cache" value="编码结果在粗、细阶段复用&lt;br&gt;四层单图特征不先压成唯一深度&lt;br&gt;每个候选按内容读取四层图像信息&lt;br&gt;多参考推理可只算一次匹配 FPN&lt;br&gt;每个参考仍独立运行 ViT 与解码" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7A8796;fontColor=#182535;fontSize=20;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="40" y="720" width="460" height="180" as="geometry" />
        </mxCell>
        <mxCell id="coarse" value="① 全范围粗匹配与空间判断&lt;br&gt;96 个 log 深度候选；格点 32×56&lt;br&gt;投影取证 → 源注意力 → 单图融合&lt;br&gt;三尺度候选卷积 → 共享评分/偏移头&lt;br&gt;候选特征 [B,64,96,32,56]" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="570" y="570" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="transport" value="② 先传递分布，再挑 4 个表面峰&lt;br&gt;同深度刻度的四邻格双线性传递&lt;br&gt;标尺控制每峰左 / 中 / 右三个采样" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="570" y="810" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fine" value="③ 12 个细候选，重新精确取证一次&lt;br&gt;在 64×112 格点融合多目和单目信息&lt;br&gt;加上继承的粗层特征（64→64）&lt;br&gt;细特征 [B,64,12,64,112]" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="570" y="990" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="heads" value="④ 保留原共享评分头 / 偏移头&lt;br&gt;score = 学习分数 + 4×匹配相似度&lt;br&gt;产生每候选原连续深度 Z_old&lt;br&gt;argmax 确定赢家；Flow 不改分数" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="570" y="1210" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="flow" value="⑤ V4 新增：三点联合局部平均流&lt;br&gt;复用细特征 + 标尺 / 可靠性统计&lt;br&gt;218→48 上下文 + 区间门控四邻域&lt;br&gt;58→48→48→3 平均速度头&lt;br&gt;每候选局部位置修正；推理默认一步" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F5E9;strokeColor=#29804B;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="1160" y="1210" width="520" height="180" as="geometry" />
        </mxCell>
        <mxCell id="select" value="⑥ 按原赢家取修正后的连续深度&lt;br&gt;[B,1,64,112]；不重新选表面&lt;br&gt;Flow 不再投影、不再读取图像" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="570" y="1440" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="up" value="⑦ 原凸组合上采样 ×4&lt;br&gt;赢家特征 → 每子像素 9 邻域权重&lt;br&gt;64→64→144；邻域深度加权" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="570" y="1610" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="out" value="输出参考相机深度 [B,1,256,448]&lt;br&gt;并保留 confidence / valid / support&lt;br&gt;接口：depth×unit_scale 恢复原单位" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="570" y="1780" width="500" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note" value="V4 是有界的条件深度纠错，不是从随机噪声生成整幅深度；全局场景节点分支关闭。&lt;br&gt;support 是几何可采样源数；输出仍是深度假设，unknown 保留，不能当作已验证表面。" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7A8796;fontColor=#182535;fontSize=20;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="60" y="1940" width="1620" height="85" as="geometry" />
        </mxCell>
        <mxCell id="e1" parent="1" edge="1" source="input" target="match" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;strokeColor=#4A72B2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;">
