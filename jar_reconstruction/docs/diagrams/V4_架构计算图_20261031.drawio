  <diagram id="v4-1" name="02 匹配融合展开">
    <mxGraphModel page="1" pageWidth="1800" pageHeight="1760" grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="匹配与融合：标尺在哪里真正参与计算？" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7A8796;fontColor=#182535;fontSize=30;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;fillColor=none;strokeColor=none;">
          <mxGeometry x="35" y="15" width="1730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="粗、细阶段分别调用本模块；细阶段还继承粗特征。示例 C=64，粗 D=96 / 细 D=12。" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7A8796;fontColor=#182535;fontSize=20;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;fillColor=none;strokeColor=none;">
          <mxGeometry x="35" y="78" width="1730" height="55" as="geometry" />
        </mxCell>
        <mxCell id="fpn" value="多目匹配金字塔 F4 / F8 / F16&lt;br&gt;每层每视图 64 通道&lt;br&gt;参考图描述子来自 F4" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="45" y="155" width="490" height="130" as="geometry" />
        </mxCell>
        <mxCell id="geometry" value="候选深度 + K/T + 掩码&lt;br&gt;精确重投影：确定各视图取证位置&lt;br&gt;投影导数：确定尺度和局部运动" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3DB;strokeColor=#B97A18;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="625" y="155" width="520" height="130" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="参考图 ViT 的四层输出&lt;br&gt;4×[B,768,16,28] → 各层128通道&lt;br&gt;按像素中心对齐到候选格点" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="1235" y="155" width="510" height="130" as="geometry" />
        </mxCell>
        <mxCell id="sample" value="几何尺度路由 + 双线性取特征&lt;br&gt;从 F4/F8/F16 取相邻层加权结果&lt;br&gt;屏蔽缺图 / 越界 / 后方 / 视差退化&lt;br&gt;描述子按通道归一化" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="45" y="365" width="490" height="160" as="geometry" />
        </mxCell>
        <mxCell id="pair" value="逐参考-源视图，构造候选证据&lt;br&gt;64维乘积 + 64维绝对差&lt;br&gt;8维分组相关 + 3维标尺量&lt;br&gt;标尺量：g 的二维方向 + 区间足迹&lt;br&gt;逐点网络 139→64→64" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="45" y="595" width="490" height="190" as="geometry" />
        </mxCell>
        <mxCell id="attn" value="4 头源视图注意力&lt;br&gt;参考 Q 与源 K：64→4×16&lt;br&gt;Q·K / √16 + 学习可靠性&lt;br&gt;加 null 分支，按源视图 masked softmax&lt;br&gt;源值加权 → 64维；拒绝量不再归一化" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="625" y="595" width="520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="embed" value="证据嵌入与深度位置编码&lt;br&gt;64维聚合 + null + 导数信息 = 66&lt;br&gt;1×1×1卷积：66→64→64&lt;br&gt;再加 [log深度位置,sin,cos] 的 3→64→64" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=20;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="625" y="875" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="layer" value="候选条件化的四层单图读取&lt;br&gt;候选特征生成查询：64→128&lt;br&gt;查询与四层128维特征分别点积&lt;br&gt;沿四层 softmax → 加权128维 → 64" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="1235" y="875" width="510" height="160" as="geometry" />
        </mxCell>
        <mxCell id="merge" value="相加 + 候选通道归一化 + 有效掩码&lt;br&gt;[B,64,D,Hq,Wq]&lt;br&gt;单图信息在每个候选上参与判断" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="625" y="1115" width="520" height="110" as="geometry" />
        </mxCell>
        <mxCell id="spatial" value="仅粗阶段：三尺度候选卷积&lt;br&gt;[B,64,96,32,56] → 16×28 → 8×14&lt;br&gt;深度轴 96 始终保留；只缩小图像平面&lt;br&gt;每尺度：逐通道 3×3×3 → GELU → 1×1×1&lt;br&gt;由小尺度向大尺度回传并残差相加" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=22;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="75" y="1315" width="740" height="190" as="geometry" />
        </mxCell>
        <mxCell id="inherit" value="细阶段：继承选中粗候选特征&lt;br&gt;当前细候选特征 + 1×1×1投影的粗特征&lt;br&gt;候选归一化 → [B,64,12,64,112]&lt;br&gt;使用原共享 score / offset 头&lt;br&gt;然后进入第03页的新 Flow；此处不再跑粗层卷积" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#4A72B2;fontColor=#182535;fontSize=22;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="965" y="1315" width="740" height="190" as="geometry" />
        </mxCell>
        <mxCell id="note" value="标尺在三处起作用：特征读取尺度、源注意力的几何条件、细候选搜索间距；新增 Flow 还读取其区间足迹。&lt;br&gt;源注意力选择“相信哪个视图”；层注意力选择“读取参考图哪层信息”。两者沿不同维度归一化。&lt;br&gt;几何有效性和可采样支持不等于无遮挡、匹配正确或表面已经存在。" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#7A8796;fontColor=#182535;fontSize=21;fontFamily=Microsoft YaHei;spacing=10;strokeWidth=2;">
          <mxGeometry x="60" y="1580" width="1680" height="120" as="geometry" />
