        <mxCell id="edge-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#526579;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="value" target="pooled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="557.5" y="840" />
