<mxfile host="app.diagrams.net" version="24.7.17" type="device">
  <diagram id="ruler-flow-1" name="01 总体数据流">
    <mxGraphModel dx="1710" dy="2160" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1710" pageHeight="2160" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="自研候选重建：从四目图像到稠密深度" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=31;fontColor=#1f3347;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="25" width="1590" height="46" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="实际版本：RulerDirectModel / spatial_volume；四目输入，仅上相机作为输出参考；下方尺寸省略 batch 维。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#1f3347;" vertex="1" parent="1">
          <mxGeometry x="60" y="78" width="1590" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-0" value="蓝：冻结预训练编码" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#1f3347;" vertex="1" parent="1">
          <mxGeometry x="60" y="119" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-1" value="绿：可训练网络" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#1f3347;" vertex="1" parent="1">
          <mxGeometry x="450" y="119" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-2" value="紫：确定性标定计算" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#1f3347;" vertex="1" parent="1">
          <mxGeometry x="840" y="119" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-3" value="橙：本轮有效替换" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#1f3347;" vertex="1" parent="1">
          <mxGeometry x="1230" y="119" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="rgb" value="&lt;b&gt;① 同一时刻的四目原始 RGB＋有效掩码&lt;/b&gt;&lt;br&gt;分别准备主图 4 × 3 × 256 × 448&lt;br&gt;以及匹配图 4 × 3 × 512 × 896" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="150" width="670" height="100" as="geometry" />
        </mxCell>
        <mxCell id="match" value="&lt;b&gt;② 四目共享匹配编码器｜冻结 ResNet-18&lt;/b&gt;&lt;br&gt;独立匹配输入：4 × 3 × 512 × 896&lt;br&gt;输出：4 × 16 × 128 × 224" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f1ff;strokeColor=#3874b8;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="295" width="530" height="140" as="geometry" />
        </mxCell>
        <mxCell id="mono" value="&lt;b&gt;③ 上相机图像编码器｜冻结 ViT-B&lt;/b&gt;&lt;br&gt;读取第 3、6、9、12 个 block&lt;br&gt;四张特征图：每张 768 × 16 × 28" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f1ff;strokeColor=#3874b8;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="700" y="295" width="510" height="140" as="geometry" />
        </mxCell>
        <mxCell id="calib" value="&lt;b&gt;已知相机标定与有效掩码&lt;/b&gt;&lt;br&gt;内参 K、rig→camera 变换 T&lt;br&gt;无效投影屏蔽；不学习修改标定" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0eafa;strokeColor=#8960ac;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1270" y="295" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="bank" value="&lt;b&gt;共享特征库：粗、细阶段复用&lt;/b&gt;&lt;br&gt;四目 16 维匹配特征&lt;br&gt;四层上相机图像特征&lt;br&gt;每层由可训练适配器 768→64" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="360" height="160" as="geometry" />
        </mxCell>
        <mxCell id="lattice" value="&lt;b&gt;④ 在上相机射线上铺设 96 个深度假设&lt;/b&gt;&lt;br&gt;粗网格：32 × 56；深度范围：2–80 米&lt;br&gt;候选深度：96 × 32 × 56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0eafa;strokeColor=#8960ac;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="535" y="500" width="650" height="115" as="geometry" />
        </mxCell>
        <mxCell id="coarse_tokens" value="&lt;b&gt;⑤ 粗级匹配与图像信息融合｜内部见第 2 页&lt;/b&gt;&lt;br&gt;候选反投影 → 精确投影其他相机 → 采样匹配特征&lt;br&gt;逐源加权与拒绝＋候选条件读取四层图像信息&lt;br&gt;候选特征：32 × 96 × 32 × 56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="535" y="665" width="650" height="120" as="geometry" />
        </mxCell>
        <mxCell id="spatial" value="&lt;b&gt;⑥ 本轮有效替换：候选空间证据交换&lt;/b&gt;&lt;br&gt;逐通道 3×3×3 卷积 → GELU → 1×1×1 卷积&lt;br&gt;加回原候选特征；尺寸保持 32 × 96 × 32 × 56" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#fff0da;strokeColor=#c37b17;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="535" y="835" width="650" height="110" as="geometry" />
        </mxCell>
        <mxCell id="coarse_head" value="&lt;b&gt;⑦ 给每个粗候选评分，并预测有界深度偏移&lt;/b&gt;&lt;br&gt;共享评分头＋源视图加权相似度；另有粗偏移头&lt;br&gt;输出：96 个分数与 96 个连续候选深度 / 粗像素" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="535" y="995" width="650" height="105" as="geometry" />
        </mxCell>
        <mxCell id="peaks" value="&lt;b&gt;⑧ 保留 4 个高分表面候选&lt;/b&gt;&lt;br&gt;按分数依次选择，使用约 1 米的候选间隔抑制&lt;br&gt;输出：4 × 32 × 56；此处仍保留多种表面可能" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="535" y="1145" width="650" height="95" as="geometry" />
        </mxCell>
        <mxCell id="fine_proposals" value="&lt;b&gt;⑨ 利用标定导数确定米制搜索步长&lt;/b&gt;&lt;br&gt;结合粗单元宽度与约半个匹配特征像素的位移&lt;br&gt;每峰生成「前一步、中心、后一步」；转到 64 × 112&lt;br&gt;细候选：4 峰 × 3 位置 = 12 × 64 × 112" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0eafa;strokeColor=#8960ac;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="535" y="1285" width="650" height="125" as="geometry" />
        </mxCell>
        <mxCell id="fine_tokens" value="&lt;b&gt;⑩ 对 12 个细候选重新精确取证与融合&lt;/b&gt;&lt;br&gt;重新投影四目取样；重新执行逐源取舍与四层读取&lt;br&gt;融合继承的粗级候选特征，再做通道归一化&lt;br&gt;细候选特征：32 × 12 × 64 × 112" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="535" y="1455" width="650" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fine_head" value="&lt;b&gt;⑪ 共享评分头：每条细射线选择一个候选&lt;/b&gt;&lt;br&gt;当前配置关闭细阶段连续偏移；选 12 个位置中的一个&lt;br&gt;细深度与置信度：1 × 64 × 112" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="535" y="1620" width="650" height="100" as="geometry" />
        </mxCell>
        <mxCell id="upsample" value="&lt;b&gt;⑫ 学习式凸组合上采样 ×4&lt;/b&gt;&lt;br&gt;获胜候选的 32 维特征 → 每格 9 × 4 × 4 个权重&lt;br&gt;以邻近 3×3 个细深度生成 4×4 个输出像素&lt;br&gt;输出：1 × 256 × 448" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="535" y="1765" width="650" height="120" as="geometry" />
        </mxCell>
        <mxCell id="output" value="&lt;b&gt;⑬ 上相机稠密米制 Z-depth&lt;/b&gt;&lt;br&gt;另有预测有效性、置信度和几何可采样源数&lt;br&gt;输出仍为深度假设；未认证为已观测表面或 free" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e4f2f5;strokeColor=#337f8c;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="535" y="1930" width="650" height="115" as="geometry" />
        </mxCell>
        <mxCell id="mask_note" value="&lt;b&gt;标定首先决定「去哪里取证」&lt;/b&gt;&lt;br&gt;反投影得到 rig 中的候选三维点&lt;br&gt;再精确投影到各相机取匹配特征&lt;br&gt;图外、相机后方、缺失视图被屏蔽&lt;br&gt;投影合法不等于未被遮挡" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1270" y="590" width="370" height="170" as="geometry" />
        </mxCell>
        <mxCell id="step_note" value="&lt;b&gt;标定导数决定「查多远」&lt;/b&gt;&lt;br&gt;估计深度变动带来的像素位移&lt;br&gt;搜索步长限制在 0.05–8 米&lt;br&gt;真正的细候选仍然精确重投影&lt;br&gt;导数不直接代替深度预测" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1230" width="370" height="165" as="geometry" />
        </mxCell>
        <mxCell id="shape_note" value="&lt;b&gt;读图说明&lt;/b&gt;&lt;br&gt;32 / 64 / 768：特征通道数&lt;br&gt;96 / 12：每像素的深度候选数&lt;br&gt;32×56 / 64×112：图像网格&lt;br&gt;候选体不是实体占据体素" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="1020" width="360" height="175" as="geometry" />
        </mxCell>
        <mxCell id="inherit_note" value="&lt;b&gt;细阶段继承粗特征（虚线）&lt;/b&gt;&lt;br&gt;取四个峰对应的 32 维特征&lt;br&gt;扩展到细网格，每峰复制三份&lt;br&gt;经 1×1×1 卷积后与新证据相加" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="1630" width="360" height="145" as="geometry" />
        </mxCell>
        <mxCell id="flags" value="&lt;b&gt;当前未执行的可选路径&lt;/b&gt;&lt;br&gt;scene 全局节点融合：关闭&lt;br&gt;源注意力额外几何偏置：关闭&lt;br&gt;细阶段 offset：关闭&lt;br&gt;不执行旧 K9 / GN 后端&lt;br&gt;未调用完整 Hero 融合 ViT / DPT" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1620" width="370" height="205" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#526579;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rgb" target="match">
          <mxGeometry relative="1" as="geometry">
