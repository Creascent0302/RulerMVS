        <mxCell id="footer" value="尺寸格式：通道 × 候选 × 高 × 宽。实线为特征或预测数据流；紫色虚线为标定依赖；灰色虚线为粗特征继承。仅展示当前实测配置。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#1f3347;" vertex="1" parent="1">
