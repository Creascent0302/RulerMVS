  <diagram id="ruler-flow-2" name="02 匹配与融合展开">
    <mxGraphModel dx="1640" dy="1670" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1670" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="一次候选匹配与融合：实际内部计算" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=31;fontColor=#1f3347;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="25" width="1520" height="46" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="粗级和细级使用同一套模块与参数。下面 D / H / W 分别取 96 / 32 / 56，或 12 / 64 / 112；省略 batch 维。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#1f3347;" vertex="1" parent="1">
          <mxGeometry x="60" y="78" width="1520" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend-0" value="蓝：冻结预训练编码" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#1f3347;" vertex="1" parent="1">
          <mxGeometry x="60" y="119" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-1" value="绿：可训练网络" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#1f3347;" vertex="1" parent="1">
          <mxGeometry x="450" y="119" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-2" value="紫：确定性标定计算" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#1f3347;" vertex="1" parent="1">
          <mxGeometry x="840" y="119" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="legend-3" value="橙：本轮有效替换" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#1f3347;" vertex="1" parent="1">
          <mxGeometry x="1230" y="119" width="380" height="25" as="geometry" />
        </mxCell>
        <mxCell id="candidate" value="&lt;b&gt;输入候选＋已知标定＋匹配特征库&lt;/b&gt;&lt;br&gt;候选深度 D × H × W；四目匹配描述子各 16 维" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f1f5f9;strokeColor=#64748b;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="650" height="100" as="geometry" />
        </mxCell>
        <mxCell id="raw" value="&lt;b&gt;上相机四层图像特征&lt;/b&gt;&lt;br&gt;每层 768 × 16 × 28；来自同一次冻结 ViT 前向" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f1ff;strokeColor=#3874b8;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="155" width="650" height="100" as="geometry" />
        </mxCell>
        <mxCell id="project" value="&lt;b&gt;A. 几何引导采样&lt;/b&gt;&lt;br&gt;反投影候选 → 精确投影 → 双线性读取源特征&lt;br&gt;同一参考像素直接读取参考描述子；屏蔽无效源&lt;br&gt;输出：参考 16 × H × W；最多三个源各 16 × D × H × W" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f0eafa;strokeColor=#8960ac;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="315" width="650" height="125" as="geometry" />
        </mxCell>
        <mxCell id="adapters" value="&lt;b&gt;E. 每层保留独立的图像信息&lt;/b&gt;&lt;br&gt;四个互不共享的 1×1 适配器：768 → 64&lt;br&gt;输出：四层，各 64 × 16 × 28&lt;br&gt;同一次适配结果被粗级、细级复用" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="315" width="650" height="125" as="geometry" />
        </mxCell>
        <mxCell id="pair" value="&lt;b&gt;B. 逐源构造内容证据&lt;/b&gt;&lt;br&gt;参考特征、源特征、逐元素乘积、绝对差&lt;br&gt;四组 16 维拼接 → 每源 64 × D × H × W" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="650" height="105" as="geometry" />
        </mxCell>
        <mxCell id="align" value="&lt;b&gt;F. 按当前网格对齐图像信息&lt;/b&gt;&lt;br&gt;遵守原始特征中心与像素坐标，双线性采样&lt;br&gt;四层图像库：4 × 64 × H × W" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="500" width="650" height="105" as="geometry" />
        </mxCell>
        <mxCell id="qk" value="&lt;b&gt;内容相似度分支&lt;/b&gt;&lt;br&gt;参考 16→16 作为 query&lt;br&gt;源 16→16 作为 key&lt;br&gt;归一化后求相似度&lt;br&gt;另由参考特征预测拒绝分数" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="665" width="305" height="145" as="geometry" />
        </mxCell>
        <mxCell id="value" value="&lt;b&gt;匹配内容与可靠性分支&lt;/b&gt;&lt;br&gt;64→16→16 的逐点网络&lt;br&gt;中间使用 SiLU&lt;br&gt;得到源 value 与可靠性分数&lt;br&gt;各候选、各源独立计算" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="405" y="665" width="305" height="145" as="geometry" />
        </mxCell>
        <mxCell id="bank" value="&lt;b&gt;保留四层，不先求固定平均&lt;/b&gt;&lt;br&gt;每个位置存四个 64 维图像向量&lt;br&gt;候选内容将在后面决定读取哪一层&lt;br&gt;图像上下文不自动算作多目观测支持" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="665" width="650" height="145" as="geometry" />
        </mxCell>
        <mxCell id="pooled" value="&lt;b&gt;C. 源视图和「拒绝接收」一起竞争&lt;/b&gt;&lt;br&gt;相似度 / 温度＋可靠性 → 带掩码的源维 softmax&lt;br&gt;输出：源 value 加权和 16 维＋null 拒绝质量 1 维&lt;br&gt;null 不接收源内容；坏源可以获得很小的权重" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="870" width="650" height="135" as="geometry" />
        </mxCell>
        <mxCell id="off" value="&lt;b&gt;当前几何注意力开关的真实状态&lt;/b&gt;&lt;br&gt;use_geometry = false：额外几何偏置、温度调节关闭&lt;br&gt;候选信息通道取零；标定仍用于精确投影、退化屏蔽&lt;br&gt;标定导数仍参与总图步骤⑨的米制搜索步长" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="870" width="650" height="135" as="geometry" />
        </mxCell>
        <mxCell id="token" value="&lt;b&gt;D. 构造 32 维候选特征&lt;/b&gt;&lt;br&gt;拼接：源内容16＋null 1＋几何信息0通道占位1 = 18&lt;br&gt;1×1×1 卷积 18→32 → GELU → 卷积 32→32&lt;br&gt;加上由深度刻度得到的 32 维位置编码" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="1065" width="650" height="140" as="geometry" />
        </mxCell>
        <mxCell id="read" value="&lt;b&gt;G. 候选条件读取四层图像信息&lt;/b&gt;&lt;br&gt;候选特征经 1×1×1 卷积：32 → query 64&lt;br&gt;与四层 64 维图像向量逐层点积 → softmax&lt;br&gt;每个深度候选可采用不同的四层权重" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="1065" width="650" height="140" as="geometry" />
        </mxCell>
        <mxCell id="message" value="&lt;b&gt;H. 将所读图像信息返回候选&lt;/b&gt;&lt;br&gt;四层加权和：64 × D × H × W&lt;br&gt;1×1×1 卷积：64 → 32" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e8f6ef;strokeColor=#288261;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="1260" width="650" height="105" as="geometry" />
        </mxCell>
        <mxCell id="fused" value="&lt;b&gt;I. 匹配证据与图像信息相加，再做通道归一化&lt;/b&gt;&lt;br&gt;每个候选独立归一化其 32 个通道；屏蔽无效参考位置&lt;br&gt;输出：32 × D × H × W，送回总图⑤或⑩" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e4f2f5;strokeColor=#337f8c;strokeWidth=1.8;fontColor=#203246;fontFamily=Arial;fontSize=19;spacing=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="1430" width="650" height="115" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#526579;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="candidate" target="project">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#526579;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="project" target="pair">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#526579;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pair" target="qk">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="385" y="635" />
              <mxPoint x="212.5" y="635" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#526579;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pair" target="value">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="385" y="635" />
              <mxPoint x="557.5" y="635" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#526579;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="qk" target="pooled">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="212.5" y="840" />
