        <mxCell id="rgb" value="&lt;b&gt;同步四目原始 RGB&lt;/b&gt;&lt;br&gt;共同场景图：4 × 3 × 256 × 448&lt;br&gt;只使用 RGB、标定与输入有效掩码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
