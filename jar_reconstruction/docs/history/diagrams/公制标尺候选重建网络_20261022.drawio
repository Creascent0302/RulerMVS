        <mxCell id="edge-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="metadata-output" target="unknown-note">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="training-lane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=21;align=center;verticalAlign=middle;spacing=12;dashed=1;dashPattern=8 5;" vertex="1" parent="1">
          <mxGeometry x="40" y="1435" width="1910" height="250" as="geometry" />
        </mxCell>
        <mxCell id="training-title" value="只在训练时出现的标签与辅助监督（橙色虚线绝不接入推理输入）" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=22;spacing=4;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1445" width="1870" height="42" as="geometry" />
        </mxCell>
        <mxCell id="gt-depth" value="&lt;b&gt;独立 targets：真实深度与有效掩码&lt;/b&gt;&lt;br&gt;本批数据实际只有上相机深度可用&lt;br&gt;缺少源相机深度则跳过真实对应监督" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=19;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="1510" width="410" height="130" as="geometry" />
        </mxCell>
        <mxCell id="gt-build" value="&lt;b&gt;由真实深度构造训练目标&lt;/b&gt;&lt;br&gt;命中前空闲／命中带表面／后方未知&lt;br&gt;物理深度单元 + 单元内连续偏移" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=19;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="505" y="1510" width="410" height="130" as="geometry" />
        </mxCell>
        <mxCell id="aux-loss" value="&lt;b&gt;候选评分与辅助损失&lt;/b&gt;&lt;br&gt;深度单元分类、三态分类、偏移监督&lt;br&gt;虚拟刻度点本身不是表面真值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=19;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="1510" width="455" height="130" as="geometry" />
        </mxCell>
        <mxCell id="offset-head" value="&lt;b&gt;连续偏移与三态辅助头&lt;/b&gt;&lt;br&gt;候选核辅助训练&lt;br&gt;&lt;b&gt;连续偏移当前未接后端&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1510" width="480" height="130" as="geometry" />
        </mxCell>
        <mxCell id="edge-29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="gt-depth" target="gt-build">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="gt-build" target="aux-loss">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="aux-loss" target="offset-head">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-32" value="仅反向监督" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#EA580C;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="aux-loss" target="score">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1177" y="1405" />
              <mxPoint x="750" y="1405" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="residual-control" value="&lt;b&gt;独立对照：保留原细候选场&lt;/b&gt;&lt;br&gt;&lt;br&gt;原细场 + α × 粗评分残差&lt;br&gt;α = 0.25&lt;br&gt;&lt;br&gt;保留原细格证据，计算开销也保留。&lt;br&gt;&lt;b&gt;它不属于上方稀疏验证主线。&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;dashed=1;dashPattern=8 5;" vertex="1" parent="1">
          <mxGeometry x="2000" y="1435" width="440" height="250" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="阅读顺序：上方五步主线 → 各框内部细节。蓝色几何只决定去哪里找、如何解释尺度；正确表面仍必须由真实图像证据支持。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="1710" width="2395" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>