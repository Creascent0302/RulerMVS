        <mxCell id="score" value="&lt;b&gt;输出完整深度评分曲线&lt;/b&gt;&lt;br&gt;192 × 16 × 28&lt;br&gt;基础评分 + 学习到的候选修正" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
