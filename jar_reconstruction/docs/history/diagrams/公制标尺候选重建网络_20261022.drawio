        <mxCell id="mono" value="&lt;b&gt;继承单图视觉编码器&lt;/b&gt;&lt;br&gt;只读取上相机场景图&lt;br&gt;4 层原始特征：每层 768 × 16 × 28" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
