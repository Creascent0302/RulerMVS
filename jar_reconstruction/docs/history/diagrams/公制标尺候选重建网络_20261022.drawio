        </mxCell>
        <mxCell id="metric-blocks" value="&lt;b&gt;公制候选更新块 × 2&lt;/b&gt;&lt;br&gt;每块：C24 × 192 × 16 × 28&lt;br&gt;沿深度读取 Z ± 0.25／1／4 米&lt;br&gt;再交换局部平面邻域的候选证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
