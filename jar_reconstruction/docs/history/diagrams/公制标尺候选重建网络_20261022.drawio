        <mxCell id="coarse" value="&lt;b&gt;按标定读取多视图证据&lt;/b&gt;&lt;br&gt;192 个深度位置 × 16 × 28 网格&lt;br&gt;粗证据：12 × 192 × 16 × 28" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=21;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
