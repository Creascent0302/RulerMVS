          <mxGeometry x="1040" y="485" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="k9" value="&lt;b&gt;每条细射线保留 9 个候选&lt;/b&gt;&lt;br&gt;原初值 + 8 个分离的深度峰&lt;br&gt;训练可扰动旧假设，再重新读取真实图像&lt;br&gt;这些是待验证假设，不是已发现表面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="640" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="observer" value="&lt;b&gt;对 9 个三维点重新精确投影&lt;/b&gt;&lt;br&gt;复用①的匹配特征，逐视图重新采样&lt;br&gt;检查图内、纹理、视差与一致性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="800" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="features19" value="&lt;b&gt;九候选真实验证特征&lt;/b&gt;&lt;br&gt;9 × 19 × 64 × 112&lt;br&gt;位置／原评分／实际多视图证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=21;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="965" width="400" height="105" as="geometry" />
        </mxCell>
        <mxCell id="evidence-note" value="&lt;b&gt;先提议，再验证&lt;/b&gt;&lt;br&gt;粗节点“可提议”不等于细点“可见”&lt;br&gt;缺视图或无足够支持，不强行接纳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1120" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="edge-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="prior" target="proposal-input">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="995" y="1277" />
              <mxPoint x="995" y="385" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="proposal-input" target="k9">
          <mxGeometry relative="1" as="geometry">
