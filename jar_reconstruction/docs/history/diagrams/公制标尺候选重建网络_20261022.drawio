        <mxCell id="edge-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="old-depth" target="k9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="k9" target="observer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="observer" target="features19">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#2563EB;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;dashPattern=8 5;" edge="1" parent="1" source="features19" target="evidence-note">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="late-reader" value="&lt;b&gt;继承原始特征后期读取器&lt;/b&gt;&lt;br&gt;复用同次单图编码的四层特征&lt;br&gt;按候选条件补充选择证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1530" y="330" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="selector" value="&lt;b&gt;共享九候选选择头：2,185 参数&lt;/b&gt;&lt;br&gt;训练期加入旧假设质量增强&lt;br&gt;分类增强组为完整研究导出版本&lt;br&gt;米制风险目标另作同预算对照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=21;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1530" y="510" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="j-refinement" value="&lt;b&gt;继承原有几何尺子细化&lt;/b&gt;&lt;br&gt;选面之后再做小范围米制定位&lt;br&gt;有界更新、精确重投影与低证据拒绝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1530" y="710" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="final-decoder" value="&lt;b&gt;继承原最终深度解码头&lt;/b&gt;&lt;br&gt;从 64 × 112 恢复至 256 × 448&lt;br&gt;保留原有边缘与局部几何处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1530" y="920" width="400" height="120" as="geometry" />
        </mxCell>
        <mxCell id="not-one-surface" value="设计分工：&lt;br&gt;&lt;br&gt;&lt;b&gt;粗层：&lt;/b&gt;便宜地保留可能的表面。&lt;br&gt;&lt;b&gt;细层：&lt;/b&gt;只为少数候选重新取证。&lt;br&gt;&lt;b&gt;细化：&lt;/b&gt;在选对表面后提高定位精度。&lt;br&gt;&lt;br&gt;不把“知道像素怎样移动”当成“已经匹配到正确表面”。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1535" y="1095" width="390" height="240" as="geometry" />
        </mxCell>
        <mxCell id="edge-22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="features19" target="selector">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1485" y="1017" />
              <mxPoint x="1485" y="567" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="late-reader" target="selector">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="selector" target="j-refinement">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="j-refinement" target="final-decoder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="depth-output" value="&lt;b&gt;全图上相机深度&lt;/b&gt;&lt;br&gt;256 × 448，单位：米&lt;br&gt;四目输入，本版只解码上相机" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=22;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="2020" y="330" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="metadata-output" value="&lt;b&gt;同时保留预测状态&lt;/b&gt;&lt;br&gt;置信度、支持数、有效性&lt;br&gt;空闲／表面／未知空间状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=21;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="2020" y="510" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="unknown-note" value="&lt;b&gt;深度假设 ≠ 已验证表面&lt;/b&gt;&lt;br&gt;当前单参考没有源视图预测深度&lt;br&gt;实测原验证器全部保留为 unknown&lt;br&gt;深度仍按全部GT评估，不删除难例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="2020" y="710" width="400" height="145" as="geometry" />
        </mxCell>
        <mxCell id="missing-inputs" value="&lt;b&gt;果断处理不良输入&lt;/b&gt;&lt;br&gt;缺参考图：不替换参考，相应输出未知&lt;br&gt;缺源图：屏蔽该视图并保留回退&lt;br&gt;遮挡后方不能标为空闲" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="2020" y="920" width="400" height="145" as="geometry" />
        </mxCell>
        <mxCell id="output-note" value="推理接口只接收：&lt;br&gt;&lt;b&gt;RGB + 实际标定 + 有效掩码。&lt;/b&gt;&lt;br&gt;&lt;br&gt;没有真实深度、语义或占据标签。&lt;br&gt;评价采用固定真值分母，不靠删除未知区美化结果。" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="2025" y="1110" width="390" height="200" as="geometry" />
        </mxCell>
        <mxCell id="edge-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=16;html=1;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;fontFamily=Microsoft YaHei;fontSize=17;fontColor=#334155;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="final-decoder" target="depth-output">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1975" y="980" />
              <mxPoint x="1975" y="387" />
