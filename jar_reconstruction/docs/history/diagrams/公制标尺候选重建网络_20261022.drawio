        </mxCell>
        <mxCell id="ruler" value="&lt;b&gt;虚拟公制标尺&lt;/b&gt;&lt;br&gt;由相机标定计算投影变化与视差&lt;br&gt;它提供空间尺度，不是额外观测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="475" width="400" height="105" as="geometry" />
        </mxCell>
        <mxCell id="source-fusion" value="&lt;b&gt;可靠视图聚合与候选入口&lt;/b&gt;&lt;br&gt;对各视图证据加权，保留拒绝通道&lt;br&gt;进入 C24 × 192 × 16 × 28 候选图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="615" width="400" height="115" as="geometry" />
        </mxCell>
        <mxCell id="raw-read" value="&lt;b&gt;候选条件化读取四层图像特征&lt;/b&gt;&lt;br&gt;不同候选选择所需层与内容&lt;br&gt;不先把每个像素压成唯一深度" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#0F172A;fontFamily=Microsoft YaHei;fontSize=20;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
