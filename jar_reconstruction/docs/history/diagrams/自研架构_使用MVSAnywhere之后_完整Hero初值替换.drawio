        <mxCell id="title" value="&lt;b&gt;自研模型：初始深度来源替换对照&lt;/b&gt;&lt;br&gt;两图采用完全相同的画布、模块位置和连线；差异只发生在下方红框内。" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontFamily=Arial;fontSize=28;fontColor=#233449;fillColor=#FFFFFF;strokeColor=#B7C3D1;strokeWidth=2;fillColor=none;strokeColor=none;align=left;" vertex="1" parent="1">
